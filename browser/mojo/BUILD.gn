shared_library("mojo") {
  output_dir = "$root_out_dir/bin"

  defines = [
    "MOJO_IMPLEMENTATION", 
    # "COMPONENT_BUILD"
  ]
  sources = [
    "core/core.cpp",
    "core/core.h",
    "core/entrypoints.cpp",
    "core/entrypoints.h",
    "core/node_controller.cpp",
    "core/node_controller.h",
    "core/data_pipe_producer_dispatcher.cpp",
    "core/data_pipe_producer_dispatcher.h",
    "core/data_pipe_consumer_dispatcher.cpp",
    "core/data_pipe_consumer_dispatcher.h",
    "core/handle_table.cpp",
    "core/handle_table.h",
    "core/request_context.cpp",
    "core/request_context.h",
    "core/dispatcher.cpp",
    "core/dispatcher.h",
    "core/ports/node.cpp",
    "core/ports/node.h",
    "core/ports/event.cpp",
    "core/ports/event.h",
    "core/ports/user_message.cpp",
    "core/ports/user_message.h",
    "core/ports/message_queue.cpp",
    "core/ports/message_queue.h",
    "core/node_channel.cpp",
    "core/node_channel.h",
    "core/platform_handle_in_transit.cpp",
    "core/platform_handle_in_transit.h",
    "core/channel.cpp",
    "core/channel.h",
    "core/watcher_set.cpp",
    "core/watcher_set.h",
    "core/watcher_dispatcher.cpp",
    "core/watcher_dispatcher.h",
    "core/watch.cpp",
    "core/watch.h",
    
    "core/data_pipe_control_message.cpp",
    "core/data_pipe_control_message.h",
    "core/user_message_impl.cpp",
    "core/user_message_impl.h",

    "public/c/system/thunks.cpp",
    "public/cpp/platform/platform_handle.cpp",
    "public/cpp/platform/platform_handle.h",
    "public/cpp/system/simple_watcher.cpp",
    "public/cpp/system/simple_watcher.h",
  ]
  
  sources += [
    "../base/memory/platform_shared_memory_region_win.cpp",
    "../base/memory/platform_shared_memory_region.cpp",
    "../base/memory/platform_shared_memory_region.h",
    "../base/memory/writable_shared_memory_region.cpp",
    "../base/memory/writable_shared_memory_region.h",
    "../base/memory/shared_memory_mapping.cpp",
    "../base/memory/shared_memory_mapping.h",
    "../base/memory/shared_memory_mapper.cpp",
    "../base/memory/shared_memory_mapper.h",
    "../base/memory/platform_shared_memory_mapper_win.cpp",
    "../base/memory/platform_shared_memory_mapper.h",
    "../base/memory/unsafe_shared_memory_region.cpp",
    "../base/memory/unsafe_shared_memory_region.h",
  ]

  include_dirs = [
    "//browser/",
    "$target_gen_dir/",
  ]
  
  cflags = [ "/wd4251" ]
}
